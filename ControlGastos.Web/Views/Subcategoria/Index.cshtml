@model IEnumerable<ControlGastos.Data.Entities.SubCategoria>
@{
    ViewData["Title"] = "Subcategorías";
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-tags text-primary"></i> Subcategorías
        </h4>
        <small class="text-muted">Gestión de subcategorías asociadas a cada categoría</small>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i> Nueva Subcategoría
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="mb-0">No hay subcategorías registradas.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm mt-3">
                    <i class="bi bi-plus-circle me-1"></i> Agregar primera subcategoría
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Categoría</th>
                            <th>Subcategoría</th>
                            <th style="width:120px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">@item.Id</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                                        <i class="bi bi-tag-fill me-1"></i>@item.IdCategoriaNavigation.Descripcion
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill p-2">
                                            <i class="bi bi-diagram-2-fill"></i>
                                        </span>
                                        <span class="fw-medium">@item.Descripcion</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-icon btn-outline-secondary me-1"
                                       title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-icon btn-outline-danger"
                                            title="Eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.Id"
                                            data-desc="@item.Descripcion"
                                            data-cat="@item.IdCategoriaNavigation.Descripcion">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal confirmación eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">
                    ¿Estás seguro de que querés eliminar la subcategoría
                    <strong id="modalDescripcion"></strong>?
                </p>
                <p class="text-muted small mb-0">
                    <i class="bi bi-tag me-1"></i>Categoría: <span id="modalCategoria" class="fw-medium"></span>
                </p>
                <p class="text-muted small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>Esta acción no se puede deshacer.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Delete" method="post" id="formEliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="inputIdEliminar" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash3 me-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('modalDescripcion').textContent = btn.dataset.desc;
            document.getElementById('modalCategoria').textContent  = btn.dataset.cat;
            document.getElementById('inputIdEliminar').value       = btn.dataset.id;
        });
    </script>
}
