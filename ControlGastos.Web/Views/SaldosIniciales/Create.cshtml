@model ControlGastos.Data.Entities.SaldosIniciale
@{
    ViewData["Title"] = "Nuevo Saldo Inicial";
    string[] meses = { "Enero","Febrero","Marzo","Abril","Mayo","Junio",
                        "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre" };
}

<div class="page-header d-flex align-items-center gap-2">
    <a asp-action="Index" asp-route-mes="@Model.Mes" asp-route-anio="@Model.Anio"
       class="btn btn-icon btn-outline-secondary me-1" title="Volver">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle text-primary"></i> Nuevo Saldo Inicial
        </h4>
        <small class="text-muted">Registrá el saldo de apertura de una cuenta</small>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card">
            <div class="card-body p-4">

                <div class="alert alert-info d-flex gap-2 align-items-start py-2 mb-4">
                    <i class="bi bi-lightbulb-fill mt-1 flex-shrink-0"></i>
                    <small>
                        El saldo inicial es el valor de la cuenta al comienzo del período.
                        Normalmente es el saldo del mes anterior menos los movimientos de ese mes.
                    </small>
                </div>

                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="IdCuenta" class="form-label fw-semibold">
                            Cuenta <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-credit-card text-muted"></i>
                            </span>
                            <select asp-for="IdCuenta" asp-items="ViewBag.Cuentas"
                                    class="form-select border-start-0">
                                <option value="">-- Seleccioná una cuenta --</option>
                            </select>
                        </div>
                        <span asp-validation-for="IdCuenta" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-7">
                            <label asp-for="Mes" class="form-label fw-semibold">
                                Mes <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Mes" class="form-select">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" selected="@(i == Model.Mes)">@meses[i - 1]</option>
                                }
                            </select>
                            <span asp-validation-for="Mes" class="text-danger small"></span>
                        </div>
                        <div class="col-5">
                            <label asp-for="Anio" class="form-label fw-semibold">
                                Año <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Anio" class="form-select">
                                @for (int y = DateTime.Today.Year + 1; y >= 2020; y--)
                                {
                                    <option value="@y" selected="@(y == Model.Anio)">@y</option>
                                }
                            </select>
                            <span asp-validation-for="Anio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Monto" class="form-label fw-semibold">
                            Monto <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input asp-for="Monto"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" asp-route-mes="@Model.Mes" asp-route-anio="@Model.Anio"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
