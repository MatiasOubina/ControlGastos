@model IEnumerable<ControlGastos.Data.Entities.SaldosIniciale>
@{
    ViewData["Title"] = "Saldos Iniciales";
    int mesFiltro  = ViewBag.MesFiltro;
    int anioFiltro = ViewBag.AnioFiltro;
    decimal total  = ViewBag.TotalSaldo;

    string[] meses = { "Enero","Febrero","Marzo","Abril","Mayo","Junio",
                        "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre" };
}

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-bank text-primary"></i> Saldos Iniciales
        </h4>
        <small class="text-muted">Registrá el saldo de apertura de cada cuenta por período</small>
    </div>
    <a asp-action="Create" asp-route-mes="@mesFiltro" asp-route-anio="@anioFiltro"
       class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i> Nuevo Saldo
    </a>
</div>

<!-- Filtro de período -->
<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-semibold small mb-1">Mes</label>
                <select name="mes" class="form-select form-select-sm" style="width:140px;">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == mesFiltro)">@meses[i - 1]</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label fw-semibold small mb-1">Año</label>
                <select name="anio" class="form-select form-select-sm" style="width:100px;">
                    @for (int y = DateTime.Today.Year + 1; y >= 2020; y--)
                    {
                        <option value="@y" selected="@(y == anioFiltro)">@y</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-search me-1"></i> Filtrar
                </button>
            </div>
            <div class="col-auto ms-auto">
                <div class="text-end">
                    <span class="text-muted small fw-semibold">Total del período</span>
                    <div class="fs-5 fw-bold text-primary">$ @total.ToString("N2")</div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="mb-0">No hay saldos iniciales para <strong>@meses[mesFiltro - 1] @anioFiltro</strong>.</p>
                <a asp-action="Create" asp-route-mes="@mesFiltro" asp-route-anio="@anioFiltro"
                   class="btn btn-primary btn-sm mt-3">
                    <i class="bi bi-plus-circle me-1"></i> Cargar saldos del período
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Cuenta</th>
                            <th style="width:120px;">Período</th>
                            <th style="width:160px;" class="text-end">Monto</th>
                            <th style="width:120px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill p-2">
                                            <i class="bi bi-credit-card-fill"></i>
                                        </span>
                                        <span class="fw-medium">@item.IdCuentaNavigation.Descripcion</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">
                                        @meses[item.Mes - 1] @item.Anio
                                    </span>
                                </td>
                                <td class="text-end fw-semibold fs-6">
                                    $ @item.Monto.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-icon btn-outline-secondary me-1" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-icon btn-outline-danger"
                                            title="Eliminar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.Id"
                                            data-cuenta="@item.IdCuentaNavigation.Descripcion"
                                            data-periodo="@meses[item.Mes - 1] @item.Anio">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2" class="fw-semibold text-end pe-3">Total</td>
                            <td class="text-end fw-bold text-primary fs-6">$ @total.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal confirmación eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">¿Eliminar el saldo inicial de <strong id="modalCuenta"></strong>?</p>
                <p class="text-muted small mb-0">
                    <i class="bi bi-calendar3 me-1"></i>Período: <span id="modalPeriodo" class="fw-medium"></span>
                </p>
                <p class="text-muted small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>Esta acción no se puede deshacer.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="inputIdEliminar" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash3 me-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('modalCuenta').textContent   = btn.dataset.cuenta;
            document.getElementById('modalPeriodo').textContent  = btn.dataset.periodo;
            document.getElementById('inputIdEliminar').value     = btn.dataset.id;
        });
    </script>
}
