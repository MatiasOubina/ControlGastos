@model ControlGastos.Data.Entities.FormasDePago
@{
    ViewData["Title"] = "Editar Forma de Pago";
}

<div class="page-header d-flex align-items-center gap-2">
    <a asp-action="Index" class="btn btn-icon btn-outline-secondary me-1" title="Volver">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-pencil-square text-warning"></i> Editar Forma de Pago
        </h4>
        <small class="text-muted">Modificá los datos de la forma de pago</small>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-1">
                        <label class="form-label text-muted small fw-semibold">ID</label>
                        <p class="fw-semibold mb-3">#@Model.Id</p>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-semibold">
                            Descripción <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-wallet text-muted"></i>
                            </span>
                            <input asp-for="Descripcion"
                                   class="form-control border-start-0 ps-0"
                                   maxlength="100"
                                   autofocus />
                        </div>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning text-white">
                            <i class="bi bi-floppy me-1"></i> Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
