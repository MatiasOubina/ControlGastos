<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Gastos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ControlGastos.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top shadow-sm" style="z-index:1040;">
        <div class="container-fluid px-3">
            <button class="btn btn-link text-white me-2 p-0 sidebar-toggle" id="sidebarToggle" type="button">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-wallet2"></i>
                Control de Gastos
            </a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white-50 small d-none d-md-inline">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>
        </div>
    </nav>

    <div class="d-flex" style="margin-top:56px; min-height:calc(100vh - 56px);">

        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar bg-dark text-white d-flex flex-column">
            <div class="sidebar-header px-3 py-3 border-bottom border-secondary">
                <span class="text-white-50 small text-uppercase fw-semibold letter-spacing-1">Navegación</span>
            </div>
            <ul class="nav flex-column flex-grow-1 px-2 py-2">
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-2"></i> Inicio
                    </a>
                </li>

                <li class="nav-item mt-2">
                    <span class="sidebar-section-label px-2 text-white-50 small text-uppercase fw-semibold">Configuración</span>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categoria" ? "active" : "")"
                       asp-controller="Categoria" asp-action="Index">
                        <i class="bi bi-tag me-2"></i> Categorías
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SubCategoria" ? "active" : "")"
                       asp-controller="Subcategoria" asp-action="Index">
                        <i class="bi bi-tag me-2"></i> Subcategorías
                    </a>
                </li>
            </ul>
            <div class="px-3 py-3 border-top border-secondary">
                <span class="text-white-50 small">&copy; @DateTime.Now.Year Control Gastos</span>
            </div>
        </nav>

        <!-- Main content -->
        <main class="flex-grow-1 p-4 main-content" id="mainContent">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["Success"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["Error"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
            document.getElementById('mainContent').classList.toggle('expanded');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
