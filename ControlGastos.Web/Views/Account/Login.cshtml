@model ControlGastos.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
    var enPasoTotp = Model.RequiereTotp && Model.PreAuthUserId.HasValue;
    var tabActiva  = enPasoTotp ? "password" : (Model.Metodo == "totp" ? "totp" : "password");
    bool tieneErrorCodigo = ViewData.ModelState["Codigo"]?.Errors.Count > 0;
    bool tieneErrorGeneral = ViewData.ModelState[string.Empty]?.Errors.Count > 0
                          || ViewData.ModelState["NombreUsuario"]?.Errors.Count > 0
                          || ViewData.ModelState["Password"]?.Errors.Count > 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Gastos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); min-height: 100vh; }
        .login-card { border: none; border-radius: 1rem; box-shadow: 0 1rem 3rem rgba(0,0,0,.175); }
        .icon-circle { width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto .75rem; background: #0d6efd; transition: background .3s; }
        .icon-circle.totp { background: #198754; }
        .otp-input { font-size: 1.5rem; letter-spacing: .5rem; text-align: center; }
        .nav-tabs .nav-link { color: #6c757d; border: none; border-bottom: 2px solid transparent; padding: .6rem 1rem; font-size: .9rem; }
        .nav-tabs .nav-link.active { color: #0d6efd; border-bottom-color: #0d6efd; font-weight: 600; background: none; }
        .nav-tabs .nav-link:hover:not(.active) { color: #495057; border-bottom-color: #dee2e6; }
        .nav-tabs { border-bottom: 1px solid #dee2e6; margin-bottom: 1.25rem; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">
<div class="container" style="max-width: 420px;">
    <div class="card login-card">
        <div class="card-body p-4 p-md-5">

            @* Ícono y título *@
            <div class="text-center mb-3">
                <div class="icon-circle @(enPasoTotp || tabActiva == "totp" ? "totp" : "")">
                    @if (enPasoTotp || tabActiva == "totp")
                    {
                        <i class="bi bi-shield-lock text-white fs-4"></i>
                    }
                    else
                    {
                        <i class="bi bi-wallet2 text-white fs-4"></i>
                    }
                </div>
                <h5 class="fw-bold mb-0">Control de Gastos</h5>
            </div>

            <form asp-action="Login" asp-controller="Account" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="RequiereTotp" />
                <input type="hidden" asp-for="PreAuthUserId" />
                <input type="hidden" asp-for="Metodo" id="campoMetodo" />
                @Html.AntiForgeryToken()

                @if (!enPasoTotp)
                {
                    @* ── Selector de método ── *@
                    <ul class="nav nav-tabs justify-content-center">
                        <li class="nav-item">
                            <button type="button" class="nav-link @(tabActiva == "password" ? "active" : "")"
                                    onclick="cambiarTab('password')">
                                <i class="bi bi-lock me-1"></i>Contraseña
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(tabActiva == "totp" ? "active" : "")"
                                    onclick="cambiarTab('totp')">
                                <i class="bi bi-shield-lock me-1"></i>Authenticator
                            </button>
                        </li>
                    </ul>

                    @* ── Campo usuario (común a ambas pestañas) ── *@
                    <div class="mb-3">
                        <label class="form-label fw-medium small">Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input name="NombreUsuario" value="@Model.NombreUsuario"
                                   class="form-control @(ViewData.ModelState["NombreUsuario"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                   placeholder="Nombre de usuario" autocomplete="username" autofocus />
                        </div>
                        @if (ViewData.ModelState["NombreUsuario"]?.Errors.Count > 0)
                        {
                            <div class="text-danger small mt-1">@ViewData.ModelState["NombreUsuario"]!.Errors[0].ErrorMessage</div>
                        }
                    </div>

                    @* ── Pestaña: Contraseña ── *@
                    <div id="tabPassword" style="display: @(tabActiva == "password" ? "block" : "none")">
                        @if (tieneErrorGeneral && tabActiva == "password")
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <div asp-validation-summary="ModelOnly"></div>
                            </div>
                        }
                        <div class="mb-4">
                            <label class="form-label fw-medium small">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input name="Password" type="password"
                                       class="form-control @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                       placeholder="Contraseña" autocomplete="current-password" />
                            </div>
                            @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                            {
                                <div class="text-danger small mt-1">@ViewData.ModelState["Password"]!.Errors[0].ErrorMessage</div>
                            }
                            @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                            {
                                <div class="text-danger small mt-1">@ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage</div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-semibold py-2"
                                onclick="document.getElementById('campoMetodo').value='password'">
                            <i class="bi bi-arrow-right-circle me-2"></i>Ingresar
                        </button>
                    </div>

                    @* ── Pestaña: Google Authenticator ── *@
                    <div id="tabTotp" style="display: @(tabActiva == "totp" ? "block" : "none")">
                        @if (tieneErrorCodigo && tabActiva == "totp")
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                @ViewData.ModelState["Codigo"]!.Errors[0].ErrorMessage
                            </div>
                        }
                        <div class="mb-1">
                            <label class="form-label fw-medium small">Código de 6 dígitos</label>
                            <input name="Codigo" value="@Model.Codigo"
                                   class="form-control otp-input @(tieneErrorCodigo && tabActiva == "totp" ? "is-invalid" : "")"
                                   placeholder="000000" maxlength="6"
                                   inputmode="numeric" autocomplete="one-time-code" />
                        </div>
                        <p class="text-muted small mb-4">
                            <i class="bi bi-phone me-1"></i>Ingresá el código de tu app Google Authenticator.
                        </p>
                        <button type="submit" class="btn btn-success w-100 fw-semibold py-2"
                                onclick="document.getElementById('campoMetodo').value='totp'">
                            <i class="bi bi-shield-check me-2"></i>Ingresar con Authenticator
                        </button>
                    </div>
                }
                else
                {
                    @* ── Paso 2: verificar TOTP luego de validar contraseña ── *@
                    <input type="hidden" asp-for="NombreUsuario" />
                    <div class="text-center mb-3">
                        <p class="text-muted small mb-0">
                            Ingresando como <strong class="text-dark">@Model.NombreUsuario</strong>
                        </p>
                    </div>
                    @if (tieneErrorCodigo)
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            @ViewData.ModelState["Codigo"]!.Errors[0].ErrorMessage
                        </div>
                    }
                    <div class="mb-1">
                        <label class="form-label fw-medium small">Código de Google Authenticator</label>
                        <input asp-for="Codigo"
                               class="form-control otp-input @(tieneErrorCodigo ? "is-invalid" : "")"
                               placeholder="000000" maxlength="6"
                               inputmode="numeric" autocomplete="one-time-code" autofocus />
                    </div>
                    <p class="text-muted small mb-4">
                        <i class="bi bi-phone me-1"></i>Abrí Google Authenticator e ingresá el código.
                    </p>
                    <button type="submit" class="btn btn-success w-100 fw-semibold py-2">
                        <i class="bi bi-check-circle me-2"></i>Verificar y entrar
                    </button>
                    <a asp-action="Login" class="btn btn-link w-100 mt-1 text-muted small">
                        <i class="bi bi-arrow-left me-1"></i>Volver al inicio
                    </a>
                }

            </form>
        </div>
    </div>
    <p class="text-center text-white-50 small mt-3">
        &copy; @DateTime.Now.Year &nbsp;|&nbsp; Desarrollado por Matías Oubiña
    </p>
</div>

<script>
    function cambiarTab(metodo) {
        document.getElementById('campoMetodo').value = metodo;
        document.getElementById('tabPassword').style.display = metodo === 'password' ? 'block' : 'none';
        document.getElementById('tabTotp').style.display     = metodo === 'totp'     ? 'block' : 'none';

        document.querySelectorAll('.nav-tabs .nav-link').forEach(function(btn) {
            btn.classList.remove('active');
        });
        event.currentTarget.classList.add('active');

        // Ícono
        var icono = document.querySelector('.icon-circle');
        if (metodo === 'totp') {
            icono.classList.add('totp');
            icono.innerHTML = '<i class="bi bi-shield-lock text-white fs-4"></i>';
        } else {
            icono.classList.remove('totp');
            icono.innerHTML = '<i class="bi bi-wallet2 text-white fs-4"></i>';
        }
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
