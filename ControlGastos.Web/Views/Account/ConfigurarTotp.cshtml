@model ControlGastos.Web.Models.ConfigurarTotpViewModel
@{
    ViewData["Title"] = "Google Authenticator";
}

<div class="d-flex justify-content-center">
    <div class="card shadow-sm" style="max-width:520px; width:100%;">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-shield-lock me-2 text-primary"></i>Google Authenticator
            </h5>
        </div>
        <div class="card-body p-4">

            @if (Model.TotpHabilitado)
            {
                <div class="alert alert-success d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check-fill fs-5"></i>
                    <span>Google Authenticator está <strong>habilitado</strong> en tu cuenta.</span>
                </div>
                <form asp-action="DeshabilitarTotp" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger"
                            onclick="return confirm('¿Deshabilitar la autenticación en dos pasos?')">
                        <i class="bi bi-shield-x me-1"></i>Deshabilitar
                    </button>
                </form>
            }
            else
            {
                <p class="text-muted mb-3">
                    Escaneá el código QR con <strong>Google Authenticator</strong> y luego ingresá
                    el código de 6 dígitos para confirmar.
                </p>

                <div class="text-center mb-3">
                    <img src="@Model.QrCodeDataUri" alt="QR Code" class="img-fluid rounded border p-2"
                         style="max-width:200px;" />
                </div>

                <div class="alert alert-light border small mb-4">
                    <strong>Clave manual:</strong>
                    <code class="ms-2 user-select-all">@Model.Secret</code>
                </div>

                <form asp-action="ConfigurarTotp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Secret" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"
                         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label fw-medium"></label>
                        <input asp-for="Codigo" class="form-control"
                               style="font-size:1.3rem; letter-spacing:.4rem; text-align:center;"
                               maxlength="6" inputmode="numeric" placeholder="000000" />
                        <span asp-validation-for="Codigo" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Confirmar y habilitar
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
