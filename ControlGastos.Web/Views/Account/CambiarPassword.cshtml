@model ControlGastos.Web.Models.CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="d-flex justify-content-center">
    <div class="card shadow-sm" style="max-width:480px; width:100%;">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-key me-2 text-primary"></i>Cambiar contraseña
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="CambiarPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"
                     style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="mb-3">
                    <label asp-for="PasswordActual" class="form-label fw-medium"></label>
                    <input asp-for="PasswordActual" class="form-control" />
                    <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NuevaPassword" class="form-label fw-medium"></label>
                    <input asp-for="NuevaPassword" class="form-control" />
                    <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmarPassword" class="form-label fw-medium"></label>
                    <input asp-for="ConfirmarPassword" class="form-control" />
                    <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
