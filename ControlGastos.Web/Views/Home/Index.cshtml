@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";

    string[] meses = { "Enero","Febrero","Marzo","Abril","Mayo","Junio",
                        "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre" };

    // Serializar datos para los gráficos
    var labelsEvolucion  = JsonSerializer.Serialize(Model.EvolucionMensual.Select(e => e.NombreMes));
    var dataIngresos     = JsonSerializer.Serialize(Model.EvolucionMensual.Select(e => e.Ingresos));
    var dataEgresos      = JsonSerializer.Serialize(Model.EvolucionMensual.Select(e => e.Egresos));
    var labelsCat        = JsonSerializer.Serialize(Model.GastosPorCategoria.Select(c => c.Categoria));
    var dataCat          = JsonSerializer.Serialize(Model.GastosPorCategoria.Select(c => c.Total));

    string[] coloresCat  = { "#0d6efd","#198754","#ffc107","#dc3545","#6f42c1","#0dcaf0" };
}

<!-- Encabezado -->
<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard
        </h4>
        <small class="text-muted">
            Resumen de <strong>@meses[Model.Mes - 1] @Model.Anio</strong>
        </small>
    </div>
    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
        <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy")
    </span>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon bg-success-subtle text-success">
                    <i class="bi bi-arrow-up-circle-fill fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Ingresos del mes</div>
                    <div class="fs-4 fw-bold text-success">$ @Model.TotalIngresos.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon bg-danger-subtle text-danger">
                    <i class="bi bi-arrow-down-circle-fill fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Egresos del mes</div>
                    <div class="fs-4 fw-bold text-danger">$ @Model.TotalEgresos.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon @(Model.BalanceNeto >= 0 ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning")">
                    <i class="bi bi-piggy-bank-fill fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Balance neto</div>
                    <div class="fs-4 fw-bold @(Model.BalanceNeto >= 0 ? "text-primary" : "text-warning")">
                        @(Model.BalanceNeto >= 0 ? "+ " : "")$ @Model.BalanceNeto.ToString("N2")
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon bg-warning-subtle text-warning">
                    <i class="bi bi-receipt fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Movimientos</div>
                    <div class="fs-4 fw-bold">@Model.CantidadMovimientos</div>
                    <div class="text-muted small">Este mes</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div class="row g-3 mb-4">

    <!-- Evolución mensual -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 h-100">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-bar-chart-line text-primary me-2"></i>Evolución mensual
                </span>
                <span class="badge bg-light text-muted border">Últimos 6 meses</span>
            </div>
            <div class="card-body px-4 pb-4 pt-2">
                @if (Model.EvolucionMensual.All(e => e.Ingresos == 0 && e.Egresos == 0))
                {
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted py-4">
                        <div class="text-center">
                            <i class="bi bi-bar-chart fs-1 d-block mb-2"></i>
                            <small>Sin datos de movimientos en los últimos 6 meses</small>
                        </div>
                    </div>
                }
                else
                {
                    <canvas id="chartEvolucion" height="220"></canvas>
                }
            </div>
        </div>
    </div>

    <!-- Gastos por categoría -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 h-100">
            <div class="card-header bg-white d-flex align-items-center py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-pie-chart text-primary me-2"></i>Gastos por categoría
                </span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center px-4 pb-4 pt-2">
                @if (!Model.GastosPorCategoria.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-pie-chart fs-1 d-block mb-2"></i>
                        <small>Sin egresos registrados este mes</small>
                    </div>
                }
                else
                {
                    <canvas id="chartCategorias" height="230"></canvas>
                }
            </div>
        </div>
    </div>
</div>

<!-- Últimos movimientos + Saldo por cuenta -->
<div class="row g-3">

    <!-- Últimos movimientos -->
    <div class="col-12 col-lg-7">
        <div class="card border-0">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-clock-history text-primary me-2"></i>Últimos movimientos
                </span>
                <a asp-controller="Movimiento" asp-action="Index"
                   class="btn btn-sm btn-outline-primary rounded-pill">Ver todos</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.UltimosMovimientos.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        <small>Sin movimientos este mes</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead>
                                <tr>
                                    <th>Descripción</th>
                                    <th>Cuenta</th>
                                    <th>Fecha</th>
                                    <th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.UltimosMovimientos)
                                {
                                    var clasif     = MovimientoHelper.GetClasificacion(m.IdTipoMovimientoNavigation.Descripcion);
                                    var colorClass = MovimientoHelper.GetColorClass(m.IdTipoMovimientoNavigation.Descripcion);
                                    var montoFmt   = MovimientoHelper.FormatMonto(m.Monto, m.IdTipoMovimientoNavigation.Descripcion);
                                    bool esIngreso = clasif == "Ingreso";
                                    bool esPasaje  = clasif == "Pasaje";

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="kpi-icon-sm @MovimientoHelper.GetBadgeClass(m.IdTipoMovimientoNavigation.Descripcion)">
                                                    <i class="bi @(esIngreso ? "bi-arrow-down-left" : esPasaje ? "bi-arrow-left-right" : "bi-arrow-up-right")"></i>
                                                </span>
                                                <span class="fw-medium">
                                                    @(string.IsNullOrEmpty(m.Detalle)
                                                        ? m.IdCategoriaNavigation.Descripcion
                                                        : m.Detalle)
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                @m.IdCuentaNavigation.Descripcion
                                            </span>
                                        </td>
                                        <td class="text-muted">@m.FechaMovimiento.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end @colorClass">@montoFmt</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Saldo por cuenta -->
    <div class="col-12 col-lg-5">
        <div class="card border-0">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-credit-card text-primary me-2"></i>Saldo por cuenta
                </span>
                <small class="text-muted">Saldo inicial + movimientos del mes</small>
            </div>
            <div class="card-body p-3">
                @if (!Model.SaldosPorCuenta.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-credit-card fs-2 d-block mb-2"></i>
                        <small>Sin cuentas registradas</small>
                    </div>
                }
                else
                {
                    string[] colores = { "primary","success","warning","info","danger","secondary" };
                    int ci = 0;
                    @foreach (var s in Model.SaldosPorCuenta)
                    {
                        var color = colores[ci++ % colores.Length];
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <span class="fw-medium">@s.Nombre</span>
                                </div>
                                <span class="fw-semibold @(s.Saldo < 0 ? "text-danger" : "")">
                                    $ @s.Saldo.ToString("N2")
                                </span>
                            </div>
                            <div class="progress" style="height:6px; border-radius:99px;">
                                <div class="progress-bar bg-@color"
                                     style="width:@s.PorcentajeRelativo%;"
                                     role="progressbar"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const muted = '#adb5bd';

        @if (Model.EvolucionMensual.Any(e => e.Ingresos > 0 || e.Egresos > 0))
        {
            <text>
            new Chart(document.getElementById('chartEvolucion'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(labelsEvolucion),
                    datasets: [
                        {
                            label: 'Ingresos',
                            data: @Html.Raw(dataIngresos),
                            backgroundColor: 'rgba(25,135,84,.7)',
                            borderRadius: 6,
                            borderSkipped: false
                        },
                        {
                            label: 'Egresos',
                            data: @Html.Raw(dataEgresos),
                            backgroundColor: 'rgba(220,53,69,.65)',
                            borderRadius: 6,
                            borderSkipped: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'top' } },
                    scales: {
                        y: {
                            ticks: {
                                callback: v => '$ ' + v.toLocaleString('es-AR'),
                                color: muted
                            },
                            grid: { color: '#f1f1f1' }
                        },
                        x: { ticks: { color: muted }, grid: { display: false } }
                    }
                }
            });
            </text>
        }

        @if (Model.GastosPorCategoria.Any())
        {
            <text>
            new Chart(document.getElementById('chartCategorias'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(labelsCat),
                    datasets: [{
                        data: @Html.Raw(dataCat),
                        backgroundColor: @Html.Raw(JsonSerializer.Serialize(coloresCat.Take(Model.GastosPorCategoria.Count).ToArray())),
                        borderWidth: 2,
                        borderColor: '#fff',
                        hoverOffset: 8
                    }]
                },
                options: {
                    cutout: '68%',
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 16, usePointStyle: true, pointStyle: 'circle', font: { size: 12 } }
                        },
                        tooltip: {
                            callbacks: {
                                label: ctx => ' $ ' + ctx.parsed.toLocaleString('es-AR')
                            }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
