@{
    ViewData["Title"] = "Dashboard";
}

<!-- Encabezado -->
<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard
        </h4>
        <small class="text-muted">Resumen general de tu control de gastos</small>
    </div>
    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
        <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("MMMM yyyy")
    </span>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon bg-success-subtle text-success">
                    <i class="bi bi-arrow-up-circle-fill fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Ingresos del mes</div>
                    <div class="fs-4 fw-bold text-success">$ 285.400</div>
                    <div class="text-muted small"><i class="bi bi-arrow-up me-1 text-success"></i>12% vs mes anterior</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon bg-danger-subtle text-danger">
                    <i class="bi bi-arrow-down-circle-fill fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Gastos del mes</div>
                    <div class="fs-4 fw-bold text-danger">$ 198.750</div>
                    <div class="text-muted small"><i class="bi bi-arrow-up me-1 text-danger"></i>5% vs mes anterior</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon bg-primary-subtle text-primary">
                    <i class="bi bi-piggy-bank-fill fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Balance neto</div>
                    <div class="fs-4 fw-bold text-primary">$ 86.650</div>
                    <div class="text-muted small"><i class="bi bi-arrow-up me-1 text-success"></i>Superávit del mes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="kpi-icon bg-warning-subtle text-warning">
                    <i class="bi bi-receipt fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Movimientos</div>
                    <div class="fs-4 fw-bold">47</div>
                    <div class="text-muted small"><i class="bi bi-dot me-1"></i>Este mes</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráfico de barras + Gastos por categoría -->
<div class="row g-3 mb-4">

    <!-- Evolución mensual -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 h-100">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-bar-chart-line text-primary me-2"></i>Evolución mensual
                </span>
                <span class="badge bg-light text-muted border">Últimos 6 meses</span>
            </div>
            <div class="card-body px-4 pb-4 pt-2">
                <canvas id="chartEvolucion" height="220"></canvas>
            </div>
        </div>
    </div>

    <!-- Gastos por categoría (donut) -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 h-100">
            <div class="card-header bg-white d-flex align-items-center py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-pie-chart text-primary me-2"></i>Gastos por categoría
                </span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center px-4 pb-4 pt-2">
                <canvas id="chartCategorias" height="230"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Últimos movimientos + Cuentas -->
<div class="row g-3">

    <!-- Últimos movimientos -->
    <div class="col-12 col-lg-7">
        <div class="card border-0">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-clock-history text-primary me-2"></i>Últimos movimientos
                </span>
                <a href="#" class="btn btn-sm btn-outline-primary rounded-pill">Ver todos</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th>Categoría</th>
                                <th>Fecha</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var movimientos = new[]
                                {
                                    new { Desc = "Supermercado Día", Cat = "Alimentación",  Fecha = "28/05/2026", Monto = "-$ 4.320",  Ingreso = false },
                                    new { Desc = "Sueldo Mayo",      Cat = "Ingresos",      Fecha = "27/05/2026", Monto = "+$ 185.000", Ingreso = true  },
                                    new { Desc = "Nafta",            Cat = "Transporte",    Fecha = "26/05/2026", Monto = "-$ 12.500",  Ingreso = false },
                                    new { Desc = "Netflix",          Cat = "Entretenimiento",Fecha = "25/05/2026", Monto = "-$ 2.900",  Ingreso = false },
                                    new { Desc = "Freelance web",    Cat = "Ingresos",      Fecha = "22/05/2026", Monto = "+$ 50.000", Ingreso = true  },
                                };
                            }
                            @foreach (var m in movimientos)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="kpi-icon-sm @(m.Ingreso ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                <i class="bi @(m.Ingreso ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>
                                            </span>
                                            <span class="fw-medium">@m.Desc</span>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-secondary border">@m.Cat</span></td>
                                    <td class="text-muted small">@m.Fecha</td>
                                    <td class="text-end fw-semibold @(m.Ingreso ? "text-success" : "text-danger")">@m.Monto</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen de cuentas -->
    <div class="col-12 col-lg-5">
        <div class="card border-0">
            <div class="card-header bg-white d-flex align-items-center py-3 px-4">
                <span class="fw-semibold">
                    <i class="bi bi-credit-card text-primary me-2"></i>Saldo por cuenta
                </span>
            </div>
            <div class="card-body p-3">
                @{
                    var cuentas = new[]
                    {
                        new { Nombre = "Cuenta corriente", Banco = "Banco Nación",   Saldo = "$ 124.300", Pct = 52, Color = "primary"  },
                        new { Nombre = "Caja de ahorro",   Banco = "Galicia",        Saldo = "$ 87.200",  Pct = 37, Color = "success"  },
                        new { Nombre = "Efectivo",         Banco = "En cartera",     Saldo = "$ 15.600",  Pct = 7,  Color = "warning"  },
                        new { Nombre = "Inversión",        Banco = "Mercado Pago",   Saldo = "$ 8.900",   Pct = 4,  Color = "info"     },
                    };
                }
                @foreach (var c in cuentas)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                <span class="fw-medium">@c.Nombre</span>
                                <span class="text-muted small ms-2">@c.Banco</span>
                            </div>
                            <span class="fw-semibold">@c.Saldo</span>
                        </div>
                        <div class="progress" style="height:6px; border-radius:99px;">
                            <div class="progress-bar bg-@c.Color" style="width:@c.Pct%;" role="progressbar"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        // Paleta
        const primary = '#0d6efd', success = '#198754', danger = '#dc3545';
        const muted = '#adb5bd';

        // ── Evolución mensual (barras agrupadas) ──
        new Chart(document.getElementById('chartEvolucion'), {
            type: 'bar',
            data: {
                labels: ['Dic', 'Ene', 'Feb', 'Mar', 'Abr', 'May'],
                datasets: [
                    {
                        label: 'Ingresos',
                        data: [210000, 195000, 230000, 215000, 260000, 285400],
                        backgroundColor: 'rgba(25,135,84,.7)',
                        borderRadius: 6,
                        borderSkipped: false,
                    },
                    {
                        label: 'Gastos',
                        data: [175000, 180000, 162000, 190000, 188000, 198750],
                        backgroundColor: 'rgba(220,53,69,.65)',
                        borderRadius: 6,
                        borderSkipped: false,
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: {
                        ticks: {
                            callback: v => '$ ' + (v / 1000).toFixed(0) + 'k',
                            color: muted
                        },
                        grid: { color: '#f1f1f1' }
                    },
                    x: { ticks: { color: muted }, grid: { display: false } }
                }
            }
        });

        // ── Gastos por categoría (donut) ──
        new Chart(document.getElementById('chartCategorias'), {
            type: 'doughnut',
            data: {
                labels: ['Alimentación', 'Transporte', 'Servicios', 'Entretenimiento', 'Otros'],
                datasets: [{
                    data: [42500, 31200, 28000, 18600, 78450],
                    backgroundColor: ['#0d6efd','#198754','#ffc107','#dc3545','#6f42c1'],
                    borderWidth: 2,
                    borderColor: '#fff',
                    hoverOffset: 8
                }]
            },
            options: {
                cutout: '68%',
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 16, usePointStyle: true, pointStyle: 'circle', font: { size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: ctx => ' $ ' + ctx.parsed.toLocaleString('es-AR')
                        }
                    }
                }
            }
        });
    </script>
}
