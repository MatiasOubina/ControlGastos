@model ControlGastos.Data.Entities.Cuenta
@{
    ViewData["Title"] = "Nueva Cuenta";
}

<div class="page-header d-flex align-items-center gap-2">
    <a asp-action="Index" class="btn btn-icon btn-outline-secondary me-1" title="Volver">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle text-primary"></i> Nueva Cuenta
        </h4>
        <small class="text-muted">Completá los datos de la nueva cuenta</small>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-semibold">
                            Descripción <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-credit-card text-muted"></i>
                            </span>
                            <input asp-for="Descripcion"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="Ej: Cuenta corriente, Caja de ahorro..."
                                   maxlength="150"
                                   autofocus />
                        </div>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
